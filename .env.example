# ─────────────────────────────────────────────────────────────────────────────
# CrimeWatch — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP (Email Alerts) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
ALERT_FROM=your_email@gmail.com
ALERT_TO=police_station@example.com,security@example.com   # comma-separated default recipients

# ── Twilio (SMS Alerts - High Severity Only) ──────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890      # your Twilio phone number
TWILIO_TO_NUMBERS=+919876543210     # comma-separated SMS recipients

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=outputs/crimewatch.db      # SQLite database location

# ── Model & Inference ─────────────────────────────────────────────────────────
MODEL_PATH=models/videomae_crime.pt      # path to trained VideoMAE checkpoint
CONFIDENCE_THRESHOLD=0.70               # minimum score to trigger an alert
PERSISTENCE_WINDOWS=3                   # consecutive windows required to alert
COOLDOWN_SECONDS=60.0                   # per-class alert suppression cooldown
NUM_FRAMES=16                           # frames sampled per clip
FRAME_SIZE=224                          # resize frames to 224x224
